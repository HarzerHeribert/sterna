{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Sterna window may call besides the app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:event:default",
    "dialog:allow-open",
    "notification:default"
  ]
}
